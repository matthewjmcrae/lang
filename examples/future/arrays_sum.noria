// Future example: arrays, indexing, and len() are not part of the current MVP.

fn sum(values: [i32], count: i32) -> i32 {
  let total: i32 = 0;
  let index: i32 = 0;

  while index < count {
    total = total + values[index];
    index = index + 1;
  }

  return total;
}

fn main() -> i32 {
  let values: [i32] = [3, 4, 5, 6];
  return sum(values, len(values));
}
