import std::dictionary::{Dictionary, dictionary_contains, dictionary_get, dictionary_insert,
                         dictionary_len, dictionary_new, dictionary_remove};

fn main() -> i32 {
  let d: Dictionary<i32, i32, hashmap> = dictionary_new(0, 0);
  dictionary_insert(d, 10, 1);
  dictionary_insert(d, 20, 2);
  let v: i32 = dictionary_remove(d, 10);
  if v != 1 {
    return 1;
  }
  if dictionary_len(d) != 1 {
    return 2;
  }
  dictionary_insert(d, 10, 100);
  if dictionary_len(d) != 2 {
    return 3;
  }
  if !dictionary_contains(d, 10) {
    return 4;
  }
  if dictionary_get(d, 10) != 100 {
    return 5;
  }
  return 0;
}
