import std::sequence::{Sequence, sequence_get, sequence_insert, sequence_len, sequence_new,
                       sequence_push, sequence_remove};

fn main() -> i32 {
  let s: Sequence<i32, arr> = sequence_new(0);
  s = sequence_push(s, 10);
  s = sequence_push(s, 20);
  s = sequence_push(s, 30);
  s = sequence_insert(s, 0, 5);
  s = sequence_insert(s, 2, 15);
  s = sequence_insert(s, 5, 40);
  if sequence_len(s) != 6 {
    return 1;
  }
  if sequence_get(s, 0) != 5 || sequence_get(s, 1) != 10 || sequence_get(s, 2) != 15 {
    return 2;
  }
  if sequence_get(s, 3) != 20 || sequence_get(s, 4) != 30 || sequence_get(s, 5) != 40 {
    return 3;
  }
  let front: i32 = sequence_remove(s, 0);
  if front != 5 {
    return 4;
  }
  let mid: i32 = sequence_remove(s, 2);
  if mid != 20 {
    return 5;
  }
  let back: i32 = sequence_remove(s, 3);
  if back != 40 {
    return 6;
  }
  if sequence_len(s) != 3 {
    return 7;
  }
  return sequence_get(s, 0) + sequence_get(s, 1) + sequence_get(s, 2);
}
