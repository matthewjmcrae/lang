import std::set::{Set, set_contains, set_insert, set_len, set_new, set_remove};

fn heap_n(n: i32) -> str {
  let s: str = "";
  let i: i32 = 0;
  while i < n {
    s = s + ".";
    i = i + 1;
  }
  return s;
}

fn check_hash_str() -> i32 {
  let s: Set<str, hashmap> = set_new("");
  set_insert(s, heap_n(1));
  set_insert(s, heap_n(2));
  set_insert(s, heap_n(1));
  set_remove(s, heap_n(1));
  set_insert(s, heap_n(1));
  let copy: Set<str, hashmap> = s;
  set_insert(copy, heap_n(3));
  s = set_new("");
  if set_len(copy) != 3 || !set_contains(copy, heap_n(1)) {
    return 1;
  }
  return 0;
}

fn check_hash_str_resize() -> i32 {
  let s: Set<str, hashmap> = set_new("");
  let i: i32 = 1;
  while i <= 10 {
    set_insert(s, heap_n(i));
    i = i + 1;
  }
  set_remove(s, heap_n(4));
  set_insert(s, heap_n(4));
  if set_len(s) != 10 || !set_contains(s, heap_n(4)) {
    return 1;
  }
  return 0;
}

fn main() -> i32 {
  if check_hash_str() != 0 {
    return 1;
  }
  if check_hash_str_resize() != 0 {
    return 2;
  }
  return 0;
}
