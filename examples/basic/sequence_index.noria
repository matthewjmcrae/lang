import std::sequence::{Sequence, sequence_len, sequence_new, sequence_push};

fn main() -> i32 {
  let s: Sequence<i32> = sequence_new(0);
  sequence_push(s, 10);
  sequence_push(s, 20);
  sequence_push(s, 30);
  if s[0] != 10 || s[1] != 20 || s[2] != 30 {
    return 1;
  }
  s[1] = 99;
  if s[1] != 99 {
    return 2;
  }
  if sequence_len(s) != 3 {
    return 3;
  }
  return s[0] + s[2];
}
