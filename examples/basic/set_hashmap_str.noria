import std::set::{Set, set_contains, set_insert, set_len, set_new, set_remove};

fn main() -> i32 {
  let s: Set<str, hashset> = set_new("");
  set_insert(s, "a");
  set_insert(s, "b");
  set_insert(s, "a");
  if set_len(s) != 2 {
    return 1;
  }
  if !set_contains(s, "b") {
    return 2;
  }
  set_remove(s, "a");
  if set_contains(s, "a") {
    return 3;
  }
  if set_len(s) != 1 {
    return 4;
  }
  return 0;
}
