fn search(nums: [i32], target: i32) -> i32 {
  let lo: i32 = 0;
  let hi: i32 = len(nums) - 1;
  while lo <= hi {
    let mid: i32 = lo + (hi - lo) / 2;
    if nums[mid] == target {
      return mid;
    }
    if nums[mid] < target {
      lo = mid + 1;
    } else {
      hi = mid - 1;
    }
  }
  return -1;
}

fn main() -> i32 {
  let nums: [i32] = [-1, 0, 3, 5, 9, 12];
  if search(nums, 9) != 4 {
    return 1;
  }
  if search(nums, 2) != -1 {
    return 2;
  }
  if search(nums, -1) != 0 {
    return 3;
  }
  return 0;
}
