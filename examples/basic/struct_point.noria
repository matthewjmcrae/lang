struct Point {
  x: i32;
  y: i32;
}

fn abs(value: i32) -> i32 {
  if value < 0 {
    return -value;
  } else {
    return value;
  }
}

fn manhattan(point: Point) -> i32 {
  return abs(point.x) + abs(point.y);
}

fn main() -> i32 {
  let origin: Point = Point { x: -3, y: 4 };
  return manhattan(origin);
}
