import std::dictionary::{Dictionary, dictionary_get, dictionary_insert, dictionary_len,
                         dictionary_new};

fn main() -> i32 {
  let d: Dictionary<i32, str, hashmap> = dictionary_new(0, "");
  dictionary_insert(d, 1, "one");
  dictionary_insert(d, 2, "two");
  if dictionary_len(d) != 2 {
    return 1;
  }
  if dictionary_get(d, 1) != "one" {
    return 2;
  }
  if dictionary_get(d, 2) != "two" {
    return 3;
  }
  dictionary_insert(d, 1, "uno");
  if dictionary_get(d, 1) != "uno" {
    return 4;
  }
  return 0;
}
