struct Box<T, I> {
  value: T;
}

fn kind<T, I>(b: Box<T, I>) -> i32 impl arr {
  return 1;
}

fn kind<T, I>(b: Box<T, I>) -> i32 impl list {
  return 2;
}

fn main() -> i32 {
  let a: Box<i32, arr> = Box<i32, arr> { value: 1 };
  let b: Box<i32, list> = Box<i32, list> { value: 2 };
  return kind(a) + kind(b);
}
