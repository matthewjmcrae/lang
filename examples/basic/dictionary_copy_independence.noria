import std::dictionary::{Dictionary, dictionary_get, dictionary_insert, dictionary_new};

fn main() -> i32 {
  let a: Dictionary<i32, i32, hashmap> = dictionary_new(0, 0);
  dictionary_insert(a, 1, 10);
  let b: Dictionary<i32, i32, hashmap> = a;
  dictionary_insert(b, 1, 99);
  if dictionary_get(a, 1) != 10 {
    return 1;
  }
  if dictionary_get(b, 1) != 99 {
    return 2;
  }
  return 0;
}
