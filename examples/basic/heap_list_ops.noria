import std::heap::{heapify, heappop, heappush};
import std::sequence::{Sequence, sequence_len, sequence_new, sequence_push};

fn check_push_pop() -> i32 {
  let s: Sequence<i32, list> = sequence_new(0);
  let h: Sequence<i32, list> = heappush(s, 5);
  let h2: Sequence<i32, list> = heappush(h, 3);
  let h3: Sequence<i32, list> = heappush(h2, 7);
  let h4: Sequence<i32, list> = heappush(h3, 1);
  let a: i32 = heappop(h4);
  let b: i32 = heappop(h4);
  let c: i32 = heappop(h4);
  let d: i32 = heappop(h4);
  if a != 1 || b != 3 || c != 5 || d != 7 {
    return 1;
  }
  if sequence_len(h4) != 0 {
    return 2;
  }
  return 0;
}

fn check_heapify() -> i32 {
  let s: Sequence<i32, list> = sequence_new(0);
  s = sequence_push(s, 4);
  s = sequence_push(s, 1);
  s = sequence_push(s, 3);
  s = sequence_push(s, 2);
  s = sequence_push(s, 16);
  s = sequence_push(s, 9);
  s = sequence_push(s, 10);
  s = heapify(s);
  let a: i32 = heappop(s);
  let b: i32 = heappop(s);
  let c: i32 = heappop(s);
  let d: i32 = heappop(s);
  let e: i32 = heappop(s);
  let f: i32 = heappop(s);
  let g: i32 = heappop(s);
  if a != 1 || b != 2 || c != 3 || d != 4 || e != 9 || f != 10 || g != 16 {
    return 3;
  }
  return 0;
}

fn main() -> i32 {
  let r1: i32 = check_push_pop();
  if r1 != 0 {
    return r1;
  }
  return check_heapify();
}
