fn merge(nums1: [i32], m: i32, nums2: [i32], n: i32) -> [i32] {
  let i: i32 = m - 1;
  let j: i32 = n - 1;
  let k: i32 = m + n - 1;
  while k >= 0 {
    if j < 0 {
      nums1[k] = nums1[i];
      i = i - 1;
    } else if i < 0 {
      nums1[k] = nums2[j];
      j = j - 1;
    } else if nums1[i] > nums2[j] {
      nums1[k] = nums1[i];
      i = i - 1;
    } else {
      nums1[k] = nums2[j];
      j = j - 1;
    }
    k = k - 1;
  }
  return nums1;
}

fn main() -> i32 {
  let nums1: [i32] = [1, 2, 3, 0, 0, 0];
  let nums2: [i32] = [2, 5, 6];
  nums1 = merge(nums1, 3, nums2, 3);
  if nums1[0] != 1 || nums1[1] != 2 || nums1[2] != 2 {
    return 1;
  }
  if nums1[3] != 3 || nums1[4] != 5 || nums1[5] != 6 {
    return 2;
  }
  return 0;
}
