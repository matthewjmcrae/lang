import std::dictionary::{Dictionary, dictionary_get, dictionary_insert, dictionary_len,
                         dictionary_new};

fn main() -> i32 {
  let d: Dictionary<f64, i32, bst> = dictionary_new(0.0, 0);
  d = dictionary_insert(d, 1.5, 15);
  d = dictionary_insert(d, 0.5, 5);
  d = dictionary_insert(d, 2.5, 25);
  if dictionary_len(d) != 3 {
    return 1;
  }
  if dictionary_get(d, 0.5) != 5 {
    return 2;
  }
  if dictionary_get(d, 2.5) != 25 {
    return 3;
  }
  return 0;
}
