import std::dictionary::{Dictionary, dictionary_get, dictionary_insert, dictionary_len,
                         dictionary_new, dictionary_remove};

fn main() -> i32 {
  let d: Dictionary<i32, str, bst> = dictionary_new(0, "");
  dictionary_insert(d, 10, "ten");
  dictionary_insert(d, 5, "five");
  dictionary_insert(d, 15, "fifteen");
  if dictionary_len(d) != 3 {
    return 1;
  }
  if dictionary_get(d, 5) != "five" {
    return 2;
  }
  let removed: str = dictionary_remove(d, 10);
  if removed != "ten" {
    return 3;
  }
  if dictionary_len(d) != 2 {
    return 4;
  }
  if dictionary_get(d, 15) != "fifteen" {
    return 5;
  }
  return 0;
}
