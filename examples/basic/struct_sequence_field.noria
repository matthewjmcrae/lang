import std::sequence::{Sequence, sequence_get, sequence_new, sequence_push};

struct Holder {
  items: Sequence<i32, arr>;
}

fn main() -> i32 {
  let box: Holder = Holder { items: sequence_new(0) };
  sequence_push(box.items, 7);
  if sequence_get(box.items, 0) != 7 {
    return 1;
  }
  return 0;
}
