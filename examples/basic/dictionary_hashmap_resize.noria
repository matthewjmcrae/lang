import std::dictionary::{Dictionary, dictionary_get, dictionary_insert, dictionary_len,
                         dictionary_new};

fn main() -> i32 {
  let d: Dictionary<i32, i32, hashmap> = dictionary_new(0, 0);
  d = dictionary_insert(d, 1, 10);
  d = dictionary_insert(d, 2, 20);
  d = dictionary_insert(d, 3, 30);
  d = dictionary_insert(d, 4, 40);
  d = dictionary_insert(d, 5, 50);
  d = dictionary_insert(d, 6, 60);
  d = dictionary_insert(d, 7, 70);
  if dictionary_len(d) != 7 {
    return 1;
  }
  if dictionary_get(d, 1) != 10 {
    return 2;
  }
  if dictionary_get(d, 7) != 70 {
    return 3;
  }
  d = dictionary_insert(d, 8, 80);
  d = dictionary_insert(d, 9, 90);
  if dictionary_len(d) != 9 {
    return 4;
  }
  if dictionary_get(d, 9) != 90 {
    return 5;
  }
  return 0;
}
