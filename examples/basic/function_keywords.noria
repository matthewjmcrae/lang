util increment(value: i32) -> i32 {
  return value + 1;
}

helper double_value(value: i32) -> i32 {
  return value + value;
}

recfn factorial(n: i32) -> i32 {
  if n <= 1 {
    return 1;
  }
  return n * factorial(n - 1);
}

fn main() -> i32 {
  return increment(3) + double_value(4) + factorial(3);
}
