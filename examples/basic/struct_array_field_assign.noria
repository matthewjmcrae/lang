struct Holder {
  items: [i32];
  grid: [[i32]];
}

struct Wrap {
  inner: Holder;
}

fn main() -> i32 {
  let h: Holder = Holder { items: [1, 2], grid: [[3, 4], [5, 6]] };
  h.items[0] = 50;
  h.grid[0][1] = 9;

  let w: Wrap = Wrap { inner: Holder { items: [0, 0], grid: [[0, 0], [0, 0]] } };
  w.inner.items[1] = 7;

  return h.items[0] + h.items[1] + h.grid[0][1] + w.inner.items[1];
}
