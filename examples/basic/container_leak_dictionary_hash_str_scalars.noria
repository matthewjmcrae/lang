import std::dictionary::{Dictionary, dictionary_insert, dictionary_new, dictionary_remove};

fn heap_n(n: i32) -> str {
  let s: str = "";
  let i: i32 = 0;
  while i < n {
    s = s + ".";
    i = i + 1;
  }
  return s;
}

fn main() -> i32 {
  let dsf: Dictionary<str, f64, hashmap> = dictionary_new("", 0.0);
  dictionary_insert(dsf, heap_n(1), 1.5);
  dictionary_insert(dsf, heap_n(2), 2.5);
  let rsf: f64 = dictionary_remove(dsf, heap_n(1));

  let dsb: Dictionary<str, bool, hashmap> = dictionary_new("", false);
  dictionary_insert(dsb, heap_n(2), true);
  dictionary_insert(dsb, heap_n(3), false);
  let rsb: bool = dictionary_remove(dsb, heap_n(2));

  if rsf != 1.5 || !rsb {
    return 1;
  }
  return 0;
}
