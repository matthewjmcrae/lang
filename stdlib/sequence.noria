import std::internal::rt::{alloc_bytes, load_at, load_i32_at, load_ptr_at, realloc_bytes,
                           release_bytes, size_of, store_at, store_i32_at, store_ptr_at};

struct Sequence<T, I> {
  private:
  handle: __rt_ptr;
}

fn sequence_new<T, I>(sample: T) -> Sequence<T, I> impl arr {
  let cap: i32 = 4;
  let header: __rt_ptr = alloc_bytes(16);
  let bytes: i32 = cap * size_of();
  let data: __rt_ptr = alloc_bytes(bytes);
  let init0: i32 = store_i32_at(header, 0, 0);
  let init1: i32 = store_i32_at(header, 1, cap);
  let init2: i32 = store_ptr_at(header, 1, data);
  return Sequence<T, I> { handle: header };
}

fn sequence_new<T, I>(sample: T) -> Sequence<T, I> impl list {
  let sentinel: __rt_ptr = alloc_bytes(20);
  let self0: i32 = store_ptr_at(sentinel, 0, sentinel);
  let self1: i32 = store_ptr_at(sentinel, 1, sentinel);
  let init_len: i32 = store_i32_at(sentinel, 4, 0);
  return Sequence<T, I> { handle: sentinel };
}

fn sequence_len<T, I>(s: Sequence<T, I>) -> i32 impl arr {
  return load_i32_at(s.handle, 0);
}

fn sequence_len<T, I>(s: Sequence<T, I>) -> i32 impl list {
  return load_i32_at(s.handle, 4);
}

fn sequence_push<T, I>(s: Sequence<T, I>, value: T) -> Sequence<T, I> impl arr {
  let len: i32 = load_i32_at(s.handle, 0);
  let cap: i32 = load_i32_at(s.handle, 1);
  if len >= cap {
    let new_cap: i32 = cap * 2;
    let old_data: __rt_ptr = load_ptr_at(s.handle, 1);
    let new_bytes: i32 = new_cap * size_of();
    let new_data: __rt_ptr = realloc_bytes(old_data, new_bytes);
    let grow0: i32 = store_ptr_at(s.handle, 1, new_data);
    let grow1: i32 = store_i32_at(s.handle, 1, new_cap);
  }
  let data: __rt_ptr = load_ptr_at(s.handle, 1);
  let push0: i32 = store_at(data, len, value);
  let push1: i32 = store_i32_at(s.handle, 0, len + 1);
  return s;
}

fn sequence_push<T, I>(s: Sequence<T, I>, value: T) -> Sequence<T, I> impl list {
  let sentinel: __rt_ptr = s.handle;
  let node_bytes: i32 = 16 + size_of();
  let node: __rt_ptr = alloc_bytes(node_bytes);
  let value_idx: i32 = 16 / size_of();
  let store_val: i32 = store_at(node, value_idx, value);
  let last: __rt_ptr = load_ptr_at(sentinel, 0);
  let link_prev: i32 = store_ptr_at(node, 0, last);
  let link_next: i32 = store_ptr_at(node, 1, sentinel);
  let patch_last: i32 = store_ptr_at(last, 1, node);
  let patch_sent: i32 = store_ptr_at(sentinel, 0, node);
  let len: i32 = load_i32_at(sentinel, 4);
  let new_len: i32 = store_i32_at(sentinel, 4, len + 1);
  return s;
}

fn sequence_get<T, I>(s: Sequence<T, I>, index: i32) -> T impl arr {
  let len: i32 = load_i32_at(s.handle, 0);
  if index < 0 || index >= len {
    __rt_trap("sequence_get: index out of bounds\n");
  }
  let data: __rt_ptr = load_ptr_at(s.handle, 1);
  return load_at(data, index);
}

fn sequence_get<T, I>(s: Sequence<T, I>, index: i32) -> T impl list {
  let len: i32 = load_i32_at(s.handle, 4);
  if index < 0 || index >= len {
    __rt_trap("sequence_get: index out of bounds\n");
  }
  let node: __rt_ptr = load_ptr_at(s.handle, 1);
  let value_idx: i32 = 16 / size_of();
  let i: i32 = 0;
  while i < index {
    node = load_ptr_at(node, 1);
    i = i + 1;
  }
  return load_at(node, value_idx);
}

fn sequence_set<T, I>(s: Sequence<T, I>, index: i32, value: T) -> Sequence<T, I> impl arr {
  let len: i32 = load_i32_at(s.handle, 0);
  if index < 0 || index >= len {
    __rt_trap("sequence_set: index out of bounds\n");
  }
  let data: __rt_ptr = load_ptr_at(s.handle, 1);
  let set0: i32 = store_at(data, index, value);
  return s;
}

fn sequence_set<T, I>(s: Sequence<T, I>, index: i32, value: T) -> Sequence<T, I> impl list {
  let len: i32 = load_i32_at(s.handle, 4);
  if index < 0 || index >= len {
    __rt_trap("sequence_set: index out of bounds\n");
  }
  let node: __rt_ptr = load_ptr_at(s.handle, 1);
  let value_idx: i32 = 16 / size_of();
  let i: i32 = 0;
  while i < index {
    node = load_ptr_at(node, 1);
    i = i + 1;
  }
  let set0: i32 = store_at(node, value_idx, value);
  return s;
}

fn sequence_pop<T, I>(s: Sequence<T, I>) -> T impl arr {
  let len: i32 = load_i32_at(s.handle, 0);
  if len <= 0 {
    __rt_trap("sequence_pop: empty sequence\n");
  }
  let data: __rt_ptr = load_ptr_at(s.handle, 1);
  let last_index: i32 = len - 1;
  let value: T = load_at(data, last_index);
  let pop0: i32 = store_i32_at(s.handle, 0, len - 1);
  return value;
}

fn sequence_pop<T, I>(s: Sequence<T, I>) -> T impl list {
  let sentinel: __rt_ptr = s.handle;
  let len: i32 = load_i32_at(sentinel, 4);
  if len <= 0 {
    __rt_trap("sequence_pop: empty sequence\n");
  }
  let last: __rt_ptr = load_ptr_at(sentinel, 0);
  let value_idx: i32 = 16 / size_of();
  let value: T = load_at(last, value_idx);
  let prev: __rt_ptr = load_ptr_at(last, 0);
  let patch_sent: i32 = store_ptr_at(sentinel, 0, prev);
  let patch_prev: i32 = store_ptr_at(prev, 1, sentinel);
  let dec: i32 = store_i32_at(sentinel, 4, len - 1);
  let free0: i32 = release_bytes(last);
  return value;
}

fn sequence_insert<T, I>(s: Sequence<T, I>, index: i32, value: T) -> Sequence<T, I> impl arr {
  let len: i32 = load_i32_at(s.handle, 0);
  if index < 0 || index > len {
    __rt_trap("sequence_insert: index out of bounds\n");
  }
  let cap: i32 = load_i32_at(s.handle, 1);
  if len >= cap {
    let new_cap: i32 = cap * 2;
    let old_data: __rt_ptr = load_ptr_at(s.handle, 1);
    let new_bytes: i32 = new_cap * size_of();
    let new_data: __rt_ptr = realloc_bytes(old_data, new_bytes);
    let grow0: i32 = store_ptr_at(s.handle, 1, new_data);
    let grow1: i32 = store_i32_at(s.handle, 1, new_cap);
  }
  let data: __rt_ptr = load_ptr_at(s.handle, 1);
  let push0: i32 = store_at(data, len, value);
  let push1: i32 = store_i32_at(s.handle, 0, len + 1);
  if index == len {
    return s;
  }
  let new_len: i32 = len + 1;
  let i: i32 = new_len - 2;
  while i >= index {
    let elem: T = load_at(data, i);
    let shift0: i32 = store_at(data, i + 1, elem);
    i = i - 1;
  }
  let insert0: i32 = store_at(data, index, value);
  return s;
}

fn sequence_remove<T, I>(s: Sequence<T, I>, index: i32) -> T impl arr {
  let len: i32 = load_i32_at(s.handle, 0);
  if index < 0 || index >= len {
    __rt_trap("sequence_remove: index out of bounds\n");
  }
  let data: __rt_ptr = load_ptr_at(s.handle, 1);
  let value: T = load_at(data, index);
  let i: i32 = index + 1;
  while i < len {
    let elem: T = load_at(data, i);
    let shift0: i32 = store_at(data, i - 1, elem);
    i = i + 1;
  }
  let remove0: i32 = store_i32_at(s.handle, 0, len - 1);
  return value;
}

fn sequence_insert<T, I>(s: Sequence<T, I>, index: i32, value: T) -> Sequence<T, I> impl list {
  let sentinel: __rt_ptr = s.handle;
  let len: i32 = load_i32_at(sentinel, 4);
  if index < 0 || index > len {
    __rt_trap("sequence_insert: index out of bounds\n");
  }
  if index == len {
    let node_bytes: i32 = 16 + size_of();
    let node: __rt_ptr = alloc_bytes(node_bytes);
    let value_idx: i32 = 16 / size_of();
    let store_val: i32 = store_at(node, value_idx, value);
    let last: __rt_ptr = load_ptr_at(sentinel, 0);
    let link_prev: i32 = store_ptr_at(node, 0, last);
    let link_next: i32 = store_ptr_at(node, 1, sentinel);
    let patch_last: i32 = store_ptr_at(last, 1, node);
    let patch_sent: i32 = store_ptr_at(sentinel, 0, node);
    let new_len: i32 = store_i32_at(sentinel, 4, len + 1);
    return s;
  }
  let node: __rt_ptr = load_ptr_at(sentinel, 1);
  let i: i32 = 0;
  while i < index {
    node = load_ptr_at(node, 1);
    i = i + 1;
  }
  let before: __rt_ptr = load_ptr_at(node, 0);
  let node_bytes: i32 = 16 + size_of();
  let new_node: __rt_ptr = alloc_bytes(node_bytes);
  let value_idx: i32 = 16 / size_of();
  let store_val: i32 = store_at(new_node, value_idx, value);
  let link_prev: i32 = store_ptr_at(new_node, 0, before);
  let link_next: i32 = store_ptr_at(new_node, 1, node);
  let patch_before: i32 = store_ptr_at(before, 1, new_node);
  let patch_node: i32 = store_ptr_at(node, 0, new_node);
  let new_len: i32 = store_i32_at(sentinel, 4, len + 1);
  return s;
}

fn sequence_remove<T, I>(s: Sequence<T, I>, index: i32) -> T impl list {
  let sentinel: __rt_ptr = s.handle;
  let len: i32 = load_i32_at(sentinel, 4);
  if index < 0 || index >= len {
    __rt_trap("sequence_remove: index out of bounds\n");
  }
  let node: __rt_ptr = load_ptr_at(sentinel, 1);
  let value_idx: i32 = 16 / size_of();
  let i: i32 = 0;
  while i < index {
    node = load_ptr_at(node, 1);
    i = i + 1;
  }
  let value: T = load_at(node, value_idx);
  let prev: __rt_ptr = load_ptr_at(node, 0);
  let next: __rt_ptr = load_ptr_at(node, 1);
  let patch_prev: i32 = store_ptr_at(prev, 1, next);
  let patch_next: i32 = store_ptr_at(next, 0, prev);
  let dec: i32 = store_i32_at(sentinel, 4, len - 1);
  let free0: i32 = release_bytes(node);
  return value;
}
