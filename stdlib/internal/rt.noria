struct PtrBox<T> {
  value: T;
}

fn alloc_bytes(size: i32) -> __rt_ptr {
  return __rt_alloc(size);
}

fn realloc_bytes(p: __rt_ptr, size: i32) -> __rt_ptr {
  return __rt_realloc(p, size);
}

fn release_bytes(p: __rt_ptr) -> i32 {
  __rt_release(p);
  return 0;
}

fn identity_ptr<T>(value: T) -> T {
  return value;
}

fn size_of<T>() -> i32 {
  return __rt_sizeof();
}

fn load_at<T>(p: __rt_ptr, index: i32) -> T {
  return __rt_load(p, index);
}

fn store_at<T>(p: __rt_ptr, index: i32, value: T) -> i32 {
  __rt_store(p, index, value);
  return 0;
}

fn load_ptr_at(p: __rt_ptr, index: i32) -> __rt_ptr {
  return __rt_load_ptr(p, index);
}

fn store_ptr_at(p: __rt_ptr, index: i32, value: __rt_ptr) -> i32 {
  __rt_store_ptr(p, index, value);
  return 0;
}

fn load_i32_at(p: __rt_ptr, index: i32) -> i32 {
  return __rt_load_i32(p, index);
}

fn store_i32_at(p: __rt_ptr, index: i32, value: i32) -> i32 {
  __rt_store_i32(p, index, value);
  return 0;
}

fn null_ptr() -> __rt_ptr {
  return __rt_null();
}

fn ptr_eq(a: __rt_ptr, b: __rt_ptr) -> bool {
  return __rt_ptr_eq(a, b);
}

fn hash_of<T>(key: T) -> i32 {
  return __rt_hash(key);
}

fn byte_offset(p: __rt_ptr, bytes: i32) -> __rt_ptr {
  return __rt_byte_offset(p, bytes);
}

fn align_up(value: i32, alignment: i32) -> i32 {
  return ((value + alignment - 1) / alignment) * alignment;
}

fn field_alignment(size: i32) -> i32 {
  if size < 8 {
    return 8;
  }
  return size;
}
